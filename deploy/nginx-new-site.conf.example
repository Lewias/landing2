# nginx server block for the built site.
#
# This project compiles to static files in dist/ — there is no Node process at
# runtime, so nginx serves the folder directly and pm2 is not involved.
#
# ONLY for a domain that nginx does not serve yet.
#
# If the domain already has a config — certbot wrote one, or an old app was
# proxied — do NOT copy this over it. Edit that file instead and pull in
# deploy/static-locations.conf. See the README.
#
# CHECK THE NAME BEFORE COPYING. Overwriting an existing config destroys the
# TLS lines certbot put there:
#
#   ls -la /etc/nginx/sites-available/        # is the name already taken?
#   sudo cp deploy/nginx-new-site.conf.example /etc/nginx/sites-available/CHOOSE-A-NAME
#
# Then edit server_name and root, and:
#   ln -s /etc/nginx/sites-available/CHOOSE-A-NAME /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d example.com -d www.example.com

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    # Point this at the dist/ folder produced by `npm run build`.
    root /home/deploy/site/dist;
    index index.html;

    # Asset filenames carry a content hash, so a stale copy can never be wrong.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Media keeps the same filename across builds, so let the browser revalidate.
    location ~* \.(mp4|webp|jpg|jpeg|png|svg|ico)$ {
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }

    # index.html must never be cached, or a deploy never reaches anyone.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Video seeking needs range requests; nginx does this by default, but the
    # mp4 module makes it explicit if the module is compiled in.
    location ~* \.mp4$ {
        add_header Accept-Ranges bytes;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Videos and webp are already compressed — gzipping them only burns CPU.
}
