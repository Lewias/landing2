# Telegram delivery for the application form.
#
# Copy to .env.local and fill in. .env.local is gitignored; .env.example is not.
#
#   1. Create a bot: message @BotFather -> /newbot -> copy the token.
#   2. Get the chat id: add the bot to the target chat, send it any message,
#      then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#      and read `result[0].message.chat.id`. For a personal chat you can also
#      just message @userinfobot.
#
# WARNING: anything prefixed VITE_ is compiled into the public JS bundle. This
# token is readable by every visitor. Use a bot that only posts into this one
# chat, never grant it admin rights, and revoke it via @BotFather if abused.
# For a token that stays secret, set `endpoint` in src/data/apply.ts to a small
# proxy instead (see README).

VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
